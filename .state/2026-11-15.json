    "rows": [
      {
        "rank": 1,
        "sign": "물고기자리",
        "lines": [
          "동료들과 협력해 큰 성과를 얻을 수 있겠어요.",
          "보고와 연락, 상담을 통해 정보를 잘 공유하세요.",
          "인터넷 쇼핑에 행운이 따라요."
        ],
        "color": "노란색",
        "item": "탁상용 버너"
      },
      {
        "rank": 2,
        "sign": "황소자리",
        "lines": [
          "좋은 물건을 싸게 사고 멋진 만남도 있는 등 행운이 가득해요.",
          "평소보다 멀리 나가보는 것이 중요해요."
        ],
        "color": "주황색",
        "item": "작업복"
      },
      {
        "rank": 3,
        "sign": "처녀자리",
        "lines": [
          "활력이 넘치고 몸과 마음이 생기 있어요.",
          "가을을 맞아 스포츠를 마음껏 즐겨보세요.",
          "유산소 운동을 하면 더욱 좋아요."
        ],
        "color": "보라색",
        "item": "토트백"
      },
      {
        "rank": 4,
        "sign": "전갈자리",
        "lines": [
          "일을 요령 있게 해결할 수 있는 날이에요.",
          "여러 일을 동시에 실수 없이 해내 평가도 좋아요.",
          "간식으로 새로 나온 디저트를 즐겨보세요."
        ],
        "color": "갈색",
        "item": "짧은 여행"
      },
      {
        "rank": 5,
        "sign": "염소자리",
        "lines": [
          "밝고 적극적으로 행동하면 매력이 높아져요.",
          "마음에 드는 사람이 호감을 갖게 되어 분위기가 좋아져요.",
          "고백하면 진지한 교제가 시작돼요."
        ],
        "color": "파란색",
        "item": "친척"
      },
      {
        "rank": 6,
        "sign": "게자리",
        "lines": [
          "업무 중 문제가 생길 수 있어요.",
          "당황하지 않고 차분히 대처하면 괜찮아요.",
          "오늘 밤은 제철 재료로 만든 요리를 드세요."
        ],
        "color": "분홍색",
        "item": "가상 체험"
      },
      {
        "rank": 7,
        "sign": "사수자리",
        "lines": [
          "화려하진 않지만 운이 안정적이에요.",
          "자기 속도대로 일을 진행할 수 있는 환경에도 만족해요.",
          "좋아하는 장소에서 기분을 전환하세요."
        ],
        "color": "초록색",
        "item": "고속도로 휴게소"
      },
      {
        "rank": 8,
        "sign": "쌍둥이자리",
        "lines": [
          "스트레스를 풀려고 쇼핑하는 건 피하세요.",
          "기분은 풀려도 지갑 사정이 어려워져요.",
          "다른 방법으로 스트레스를 푸세요."
        ],
        "color": "금색",
        "item": "문구점"
      },
      {
        "rank": 9,
        "sign": "물병자리",
        "lines": [
          "말을 능숙하게 하는 사람을 조심하세요.",
          "어느새 속아서 이용당할 위험이 있어요.",
          "쉽게 말에 넘어가지 말고 거리를 두는 것이 현명해요."
        ],
        "color": "빨간색",
        "item": "장지갑"
      },
      {
        "rank": 10,
        "sign": "천칭자리",
        "lines": [
          "상대의 마음을 지나치게 짐작하면 좋은 관계가 깨질 수 있어요.",
          "들은 말은 있는 그대로 받아들이세요.",
          "불안한 일은 제대로 전하세요."
        ],
        "color": "은색",
        "item": "방법을 알려주는 동영상"
      },
      {
        "rank": 11,
        "sign": "양자리",
        "lines": [
          "일은 장기전이 될 조짐이고 결과가 나오려면 아직 멀었어요.",
          "조급해하지 말고 차분히 끈기 있게 임하세요.",
          "가을 제철 음식을 맛보면 좋아요."
        ],
        "color": "회색",
        "item": "미술 도구"
      },
      {
        "rank": 12,
        "sign": "사자자리",
        "lines": [
          "과로의 여파가 나타날 수 있어요.",
          "무리하지 말고 몸을 쉬게 하세요.",
          "급한 일 등 어쩔 수 없는 경우에는 도움을 요청하세요."
        ],
        "color": "흰색",
        "item": "이모지"
      }
    ]
  },
