      {
        "rank": 1,
        "sign": "사자자리",
        "lines": [
          "부업이 성공해 새로운 수입원이 될 가능성이 커요.",
          "잘하는 분야를 살리는 데 집중해요.",
          "협업 기획도 성공할 것 같아요."
        ],
        "color": "보라색",
        "item": "원예"
      },
      {
        "rank": 2,
        "sign": "사수자리",
        "lines": [
          "연애운이 아주 좋아요.",
          "마음에 드는 사람이 다가와 설레는 순간도 있어요.",
          "소중한 사람과 당일 여행을 가면 유대가 깊어져요."
        ],
        "color": "회색",
        "item": "수공예"
      },
      {
        "rank": 3,
        "sign": "쌍둥이자리",
        "lines": [
          "힘찬 행동력을 발휘해요.",
          "타고난 민첩함으로 알찬 시간을 보낼 수 있겠어요.",
          "이른 아침 걷기도 추천해요."
        ],
        "color": "베이지색",
        "item": "체험 세트"
      },
      {
        "rank": 4,
        "sign": "물고기자리",
        "lines": [
          "일과 집안일을 하는 속도가 빨라져요.",
          "적극적으로 움직일수록 성과를 실감해요.",
          "현관과 물을 쓰는 곳을 중심으로 청소하면 좋아요."
        ],
        "color": "빨간색",
        "item": "벼룩시장"
      },
      {
        "rank": 5,
        "sign": "황소자리",
        "lines": [
          "마음이 끌리는 사람을 만날 징조예요.",
          "공통 취미를 발견하는 등 마음이 통하는 때예요.",
          "크리스마스 행사 준비에 행운이 따라요."
        ],
        "color": "노란색",
        "item": "넥타이"
      },
      {
        "rank": 6,
        "sign": "양자리",
        "lines": [
          "단풍 구경을 하기에 아주 좋아요.",
          "야외 활동이나 드라이브 데이트도 즐거울 것 같아요.",
          "대화에 유머를 더하면 웃음이 끊이지 않는 날이에요."
        ],
        "color": "갈색",
        "item": "오디오 세트"
      },
      {
        "rank": 7,
        "sign": "전갈자리",
        "lines": [
          "외출한 곳에서 뜻밖의 일이 생겨요.",
          "예절과 규칙을 중시하고 즉흥적인 행동은 피해요.",
          "주변 사람들과의 조화를 소중히 해요."
        ],
        "color": "초록색",
        "item": "여행 안내"
      },
      {
        "rank": 8,
        "sign": "물병자리",
        "lines": [
          "필요한 물건을 사기에 아주 좋은 날이에요.",
          "기능적인 겉옷이나 난방 기구를 찾을 수 있겠어요.",
          "먼저 예산을 정해요."
        ],
        "color": "검은색",
        "item": "드라이브스루"
      },
      {
        "rank": 9,
        "sign": "천칭자리",
        "lines": [
          "편한 사이인 동료에게도 예의를 지켜요.",
          "허술한 인상을 주지 않도록 해요.",
          "옷차림은 때와 장소, 상황에 맞게 골라요."
        ],
        "color": "하늘색",
        "item": "코미디 책"
      },
      {
        "rank": 10,
        "sign": "염소자리",
        "lines": [
          "파트너에게 지나치게 기대해 실망할 일이 생겨요.",
          "서로의 생각과 능력을 존중해요.",
          "함께 외식을 즐기면 상황이 좋아져요."
        ],
        "color": "남색",
        "item": "홈센터"
      },
      {
        "rank": 11,
        "sign": "처녀자리",
        "lines": [
          "가족에게 화풀이하기 쉬워요.",
          "감정 기복이 심하니 먼저 심호흡해요.",
          "동물이나 식물과 교감하면 마음이 편안해져요."
        ],
        "color": "금색",
        "item": "교통카드"
      },
      {
        "rank": 12,
        "sign": "게자리",
        "lines": [
          "수상한 전화나 메일은 경계해요.",
          "자칫 사기에 걸려들 수 있어요.",
          "혼자 판단해 대응하지 말고 지인에게 상담해요."
        ],
        "color": "분홍색",
        "item": "히트곡"
      }
    ]
